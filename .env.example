# Neue Kabel (brand body font) from an Adobe Fonts web project.
# Create the project in Adobe Fonts, add Neue Kabel, and allow this app's domains.
# Without it, the brand's approved digital fallback (Trebuchet MS) is used.
NEXT_PUBLIC_ADOBE_FONTS_KIT_ID=


# Preview links (Share button) are stored in a Vercel Blob store. Connecting the
# store to the project in Vercel sets its token automatically. Set BLOB_ACCESS=private
# only if the store was created as private.
# BLOB_ACCESS=public
